# .env.example
# Environment defaults for CacheCraft testing and cluster configuration.
# Copy this file to .env to customize local variables.

# Base URL of the Nginx load balancer (distributes across api-1, api-2, api-3)
BASE_URL=http://localhost:8080

# Default item ID used for stampede and baseline tests
TEST_ITEM_ID=42

# Default target URL constructed from BASE_URL and TEST_ITEM_ID
TARGET_URL=http://localhost:8080/api/items/42

# Default ports for the 3 API instances
API_1_PORT=8081
API_2_PORT=8082
API_3_PORT=8083
